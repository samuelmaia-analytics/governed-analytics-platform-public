/powerbi/*.png
*.pbix
*.pbit
/dist/

# Generated logs and local documents must not enter distribution.
/logs/*
!/logs/.gitkeep
*.pdf
*.docx
*.xlsx

# Historical CSV fixtures remain private; regression uses in-memory generators.
/tests/fixtures/
/docs/reports/
/docs/governance/lgpd*.md
